# zoompilot develop: opendbc submodule served from the user's fork
# This branch carries the CX-8 Starcx8 steering tune.
[submodule "panda"]
  path = panda
  url = https://github.com/pdscomp/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/nguyenngoc95vp/opendbc.git
[submodule "msgq"]
  path = msgq_repo
  url = https://github.com/sunnypilot/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/sunnypilot/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
\tpath = openpilot/sunnypilot/neural_network_data
  url = https://github.com/sunnypilot/neural-network-data.git
